{
  "name": "@pogly/spacetimedb-relations",
  "version": "0.1.3",
  "description": "Foreign keys, cascading deletes, multi-column unique, integrity check/repair and pagination for SpacetimeDB, as a submodule. Same schema as relations.rs / Relations.cs.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "spacetimedb",
    "submodule",
    "foreign-keys",
    "cascade",
    "relations",
    "pagination"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gazz-Stripbolt/spacetimedb-relations.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/Gazz-Stripbolt/spacetimedb-relations/tree/main/typescript#readme",
  "bugs": {
    "url": "https://github.com/Gazz-Stripbolt/spacetimedb-relations/issues"
  },
  "submodule": {
    "category": "database"
  },
  "peerDependencies": {
    "spacetimedb": "2.13.* || 2.14.*"
  },
  "devDependencies": {
    "spacetimedb": "2.14.*",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
